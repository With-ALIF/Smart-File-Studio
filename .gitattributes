# Normalize line endings for everyone.
# Files are stored with LF in the repository and checked out as LF as well.
* text=auto eol=lf

# Windows-only shell scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common web/text assets – force LF so diffs stay clean.
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.csv   text eol=lf

# Never touch lockfiles beyond normalising their line endings.
package-lock.json text eol=lf

# Binary assets – never let Git try to normalise these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.bmp     binary
*.ico     binary
*.pdf     binary
*.heic    binary
*.zip     binary
*.gz      binary
*.ttf     binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.mp4     binary
*.webm    binary
*.mp3     binary
*.wav     binary

# Keep diffs quiet for generated / vendored output.
dist/**    -diff
node_modules/** -diff
*.log      text eol=lf